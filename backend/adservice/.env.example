# --- AD SERVICE CONFIG ---
GRPC_PORT=50053
LOG_LEVEL=INFO
ENVIRONMENT=production

# --- DATABASE ---
DB_HOST=localhost
DB_PORT=5433
DB_USER=ad_user
DB_PASSWORD=ad_pass
DB_NAME=ad_db
DB_SSL_MODE=prefer

DB_MAX_CONNECTIONS=30
DB_MIN_CONNECTIONS=10
DB_MAX_CONNECTION_LIFETIME=10m
DB_MAX_CONNECTION_IDLETIME=5m

# --- MONGODB ---
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_USER=ad_user
MONGO_PASSWORD=ad_pass
MONGO_DB_NAME=ad_db
MONGO_COLLECTION_NAME=ads

# --- RABBITMQ ---
RABBIT_HOST=localhost
RABBIT_PORT=5672
RABBIT_USER=guest
RABBIT_PASSWORD=guest

RABBIT_WAIT_TIME=10s
RABBIT_ATTEMPTS=5

AD_EXCHANGE=ad_topic
AD_PUBLISHED_ROUTING_KEY=ad.published
AD_UPDATED_ROUTING_KEY=ad.updated
AD_REJECTED_ROUTING_KEY=ad.rejected
AD_DELETED_ROUTING_KEY=ad.deleted
